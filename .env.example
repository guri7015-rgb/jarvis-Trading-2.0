# ── OANDA ──────────────────────────────────────────────
OANDA_API_KEY=your_oanda_practice_token_here
OANDA_ACCOUNT_ID=your_account_id_here
OANDA_ENV=practice          # practice | live

# ── AI ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Optional ───────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key_here   # for breaking news layer
PORT=4000

# ── Safety locks (default OFF = safe) ──────────────────
JARVIS_READ_ONLY=true               # set false to enable execution
DEMO_TRADING_ENABLED=false           # set true to trade on practice
