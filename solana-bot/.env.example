# solana-bot environment. Copy to .env (git-ignored) and fill in locally.
# Never paste these values into chat, logs, issues or commits.

# Solana RPC (HTTP + WebSocket). Defaults to the public endpoint, which is
# rate-limited and "not intended for production". A Helius free-plan URL
# (contains your key) goes here once you create one.
SOLANA_RPC_URL=https://api.mainnet.solana.com
SOLANA_WS_URL=wss://api.mainnet.solana.com

# Jupiter API key from developers.jup.ag/portal (free plan = 1 req/s).
# Leave blank for keyless (0.5 req/s).
JUPITER_API_KEY=

# Daily cap on Solana RPC calls made by this bot. Keeps the Helius free plan
# (1M credits/month) from running out. ~25k/day is ~750k/month.
RPC_DAILY_CALL_BUDGET=25000

# Where the SQLite state file lives.
DATA_DIR=./data

# There is deliberately no setting that enables live trading in this phase.
